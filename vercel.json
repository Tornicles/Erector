{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "frontend": {
      "root": "frontend/",
      "framework": "vite",
      "buildCommand": "npm run build",
      "outputDirectory": "dist"
    },
    "api": {
      "root": "backend/",
      "framework": "fastapi",
      "entrypoint": "vercel_app:app",
      "functions": {
        "vercel_app.py": {
          "excludeFiles": "{tests/**,**/tests/**,**/__pycache__/**,**/*.pyc,**/.venv/**}"
        }
      }
    }
  },
  "rewrites": [
    {
      "source": "/api",
      "destination": { "service": "api" }
    },
    {
      "source": "/api/(.*)",
      "destination": { "service": "api" }
    },
    {
      "source": "/assets/(.*)",
      "destination": { "service": "frontend" }
    },
    {
      "source": "/marketing/(.*)",
      "destination": { "service": "frontend" }
    },
    {
      "source": "/robots.txt",
      "destination": { "service": "frontend" }
    },
    {
      "source": "/sitemap.xml",
      "destination": { "service": "frontend" }
    },
    {
      "source": "/((?!api|assets|marketing).*)",
      "destination": { "service": "frontend", "path": "/index.html" }
    },
    {
      "source": "/(.*)",
      "destination": { "service": "frontend" }
    }
  ]
}
