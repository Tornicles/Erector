# Copy to backend/.env; never commit credentials.
APP_ENV=development
APP_VERSION=0.1.0
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Optional until a privileged service is implemented. NEVER use in the frontend.
SUPABASE_SERVICE_ROLE_KEY=
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL=INFO
# AI, billing, email and worker providers are not enabled in Prompt 1.
# Add provider-specific server secrets only with their implementation/migration.
