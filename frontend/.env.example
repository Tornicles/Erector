# Copy to .env.local. Browser-visible values only; NEVER put a service-role/secret key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Local interface iteration only; never treat this as a configured project.
VITE_TONDE_LOCAL_PREVIEW=
# Local privileged backend; use your own HTTPS API origin in production.
VITE_API_URL=http://127.0.0.1:8001
